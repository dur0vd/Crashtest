{
  "name": "crashtest",
  "version": "0.2.0",
  "private": true,
  "description": "Симулятор дорожных ситуаций с разбором по ПДД РФ, КоАП РФ и УК РФ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node src/cli/prepare-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "test:browser": "playwright test",
    "validation-data": "node tools/fetch-validation-data.mjs",
    "validation-report": "node --import tsx tools/validation-report.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@stdlib/math-base-special-acos": "0.2.4",
    "@stdlib/math-base-special-atan": "0.2.4",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-exp": "0.2.5",
    "@stdlib/math-base-special-hypot": "0.2.4",
    "@stdlib/math-base-special-ln": "0.2.5",
    "@stdlib/math-base-special-sin": "0.3.1",
    "@stdlib/math-base-special-tan": "0.3.1",
    "docx": "^9.13.0",
    "exifr": "^7.1.3",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "mediabunny": "^1.62.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15"
  },
  "bin": {
    "crashtest-verify": "src/cli/bin.mjs"
  }
}
